# local: one example environment. One file per environment; bin/deploy.sh
# takes the environment's NAME and derives every target fact from here, so a
# script cannot assume one cluster while acting on another. starling runs in
# the namespace named for its environment. Same service names in every
# environment; EDGE_PORT is how the host reaches this cluster's edge.
# starling keeps no data on the host by design (its store is disposable), so
# there is no data root here. Copy this file to add an environment.
ENV=local
CLUSTER=local
CTX=k3d-local
EDGE_PORT=9800
